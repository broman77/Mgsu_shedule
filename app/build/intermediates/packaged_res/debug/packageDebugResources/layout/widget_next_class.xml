<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="#F5F7FA">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="МГСУ Расписание" android:textStyle="bold" android:textColor="#0F3C73" android:textSize="14sp"/>
    <TextView android:id="@+id/widget_event" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Следующее занятие" android:textStyle="bold" android:textColor="#202124" android:textSize="17sp" android:maxLines="2"/>
    <TextView android:id="@+id/widget_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:text="08:30 · 3206" android:textColor="#5F6368" android:textSize="13sp"/>
</LinearLayout>
