<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="#FFFFFF">
    <TextView android:id="@+id/widget_day" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="15 сентября" android:textStyle="bold" android:textColor="#0F3C73" android:textSize="16sp"/>
    <TextView android:id="@+id/widget_count" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="3 занятия" android:textColor="#5F6368" android:textSize="12sp"/>
    <TextView android:id="@+id/widget_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp" android:text="08:30  Математика" android:textColor="#202124" android:textSize="13sp" android:maxLines="5"/>
</LinearLayout>
